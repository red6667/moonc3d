// Editing is explicitly different from a format-only transcode. Dependent
// optional metadata is removed when its channel/frame/coordinate references
// would otherwise become stale. Mandatory fields are regenerated by write.

///|
fn edited_metadata(
  m : Metadata,
  channels~ : Bool = false,
  timing~ : Bool = false,
  geometry~ : Bool = false,
) -> Metadata {
  let drop : Array[String] = []
  if channels {
    drop.push("POINT")
    drop.push("ANALOG")
  }
  if channels || timing {
    drop.push("EVENT")
    drop.push("TRIAL")
    drop.push("ANALYSIS")
  }
  if channels || timing || geometry {
    drop.push("FORCE_PLATFORM")
  }
  {
    groups: m.groups.filter(g => !drop.contains(g.name)),
    parameters: m.parameters.filter(p => !drop.contains(p.group)),
  }
}
