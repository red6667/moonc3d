// Synthetic fixtures from the pinned reference; see fixtures/README.md.

///|
test "reference fixture float-intel" {
  let t = read(
    decode_hex(
      "",
    ),
  )
  assert_eq(t.first_frame, 7)
  assert_eq(t.frames.length(), 3)
  assert_eq(t.frames[1].points[1].residual, -1.0)
  assert_eq(t.frames[2].points[0].x, 3.5)
  assert_eq(t.frames[2].analog, [[3.0, 5.0], [4.0, 6.0]])
}

